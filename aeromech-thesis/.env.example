# aeromech-thesis Image Model API 配置模板（v1.6.5，全部占位值，无真实凭据）
#
# 用法：复制本文件为  ~/.aeromech/.env  后填入您自己的值。
#   （推荐交互式生成：python scripts/image_cli.py config —— API Key 输入不回显）
#
# 外部 Image Model API 是【可选增强】：不配置任何键，Skill 照常使用既有
# Figure Pipeline（figkit/mermaid 确定性图形）生成论文图，零阻塞零费用。
#
# 计费提示：配置后，适合 AI 的概念/示意类图将使用您自己的 Key 调用外部服务，
# 可能产生您的 API 费用；确定性研究图（故障树/统计图/计算图）始终本地生成。

IMAGE_BACKEND=openai                       # openai | gemini | qwen | zhipu | minimax | volcengine | host_native

OPENAI_API_KEY=YOUR_API_KEY
OPENAI_MODEL=gpt-image-2                   # 建议默认，可改
OPENAI_BASE_URL=YOUR_BASE_URL              # 可选：代理/私有端点；留空=官方

# —— 其它后端按需启用（provider-specific，前缀互不复用；不存在全局 IMAGE_API_KEY）——
# IMAGE_BACKEND=gemini
# GEMINI_API_KEY=YOUR_API_KEY
# GEMINI_MODEL=gemini-3.1-flash-image
# GEMINI_BASE_URL=YOUR_BASE_URL

# 高级选项（默认全部关闭/无需改动）：
# IMAGE_ALLOW_PROJECT_ENV=1               # 允许读取当前目录 .env（不推荐，项目会被分享）
# IMAGE_MAX_ATTEMPTS=3                    # 每图外部调用成本闸（自动重生成上限）
